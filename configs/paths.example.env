# Copy to a local shell snippet if useful:
#   cp configs/paths.example.env .env.local
#   source .env.local

export WANDB_MODE=disabled

# Independent output roots used by the checked-in manifests.
export GATEDSRP_CLASSIFICATION_OUT=runs/classification
export GATEDSRP_TCGA_SURVIVAL_OUT=runs/survival_tasks
export GATEDSRP_COMPONENT_OUT=runs/component_variants
