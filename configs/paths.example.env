export GATEDSRP_COEFFICIENT_OUT=runs/coefficient_parameterizations
export GATEDSRP_RUNTIME_OUT=runs/runtime_efficiency

# These defaults keep a self-contained layout under this repository. For shared
# server storage, copy this file to .env.local and replace any raw/feature root
# with an absolute path; the manifests read these variables directly.
export CAM16_RAW_ROOT=data/raw/camelyon16/training
export CAM17_RAW_ROOT=data/raw/camelyon17/images
export KGH_RAW_ROOT=data/raw/kgh
export PANDA_RAW_ROOT=data/raw/panda/train_images
export BRACS_RAW_ROOT=data/raw/bracs
